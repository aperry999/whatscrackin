# Postgres connection string. On Vercel, adding Neon from the Storage tab fills this in.
DATABASE_URL=

# Any random string of 32+ characters. Signs admin sessions.
SESSION_SECRET=

# The site's public address, used in sign-in links.
SITE_URL=https://whatscrackin.us

# SendGrid (admin sign-in and invite emails for now, trip emails in phase 2)
SENDGRID_API_KEY=
EMAIL_FROM=hello@whatscrackin.us

# beehiiv (newsletter signups)
BEEHIIV_API_KEY=
BEEHIIV_PUBLICATION_ID=

# JSON feed of events from the event engine (see README). Leave blank to hide the homepage board.
EVENTS_FEED_URL=

# Timezone used to decide what "this week" means on the homepage.
SITE_TZ=America/New_York

# Your email. Becomes the first owner account the first time the site runs.
OWNER_EMAIL=
